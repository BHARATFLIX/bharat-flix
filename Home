<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bharat Flix</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Roboto,Arial,sans-serif;}
body{background:#ffffff; padding-bottom:90px;}
.header{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:#fff;position:sticky;top:0;z-index:100;border-bottom:1px solid #eee;}
.logo-left{display:flex;align-items:center;gap:8px;}
.b-icon{width:40px;height:40px;border-radius:50%;background:linear-gradient(to bottom,#FF9933 33%,#fff 33%,#fff 66%,#138808 66%);display:flex;justify-content:center;align-items:center;font-weight:900;font-size:22px;border:2px solid #e0e0e0;}
.bharat-text{font-weight:900;font-size:21px;line-height:13px;}
.bharat-text div:last-child{font-size:10px;letter-spacing:2px;color:#000;margin-top:2px;}
.right{display:flex;align-items:center;gap:12px;}
.profile-top{width:34px;height:34px;border-radius:50%;background:#6d28d9;color:#fff;display:flex;justify-content:center;align-items:center;font-weight:900;font-size:18px;}
.search{padding:10px 14px;}
.search input{width:100%;background:#f1f1f1;border:1px solid #e5e5e5;border-radius:25px;padding:11px 16px;outline:none;}
.chips{display:flex;gap:8px;padding:8px 14px;overflow-x:auto;white-space:nowrap;}
.chips span{background:#f1f1f1;padding:7px 14px;border-radius:8px;font-size:14px;}
.chips .active{background:#0f0f0f;color:#fff;}
.video{width:100%;height:220px;background:#000;position:relative;}
.video video{width:100%;height:100%;object-fit:contain;}
.details{padding:12px 14px;}
.actions{display:flex;gap:8px;overflow-x:auto;margin:10px 0;}
.actions span{background:#f1f1f1;padding:7px 12px;border-radius:20px;font-size:13px;white-space:nowrap;}
.subscribe{background:red;color:#fff;border:none;padding:8px 16px;border-radius:20px;font-weight:700;}
.bottom{position:fixed;bottom:0;left:0;width:100%;background:#fff;border-top:1px solid #ddd;display:flex;justify-content:space-around;align-items:flex-end;padding:6px 0 10px 0;z-index:200;}
.nav{font-size:11px;display:flex;flex-direction:column;align-items:center;color:#606060;gap:2px;}
.nav.active{color:#000;font-weight:700;}
.plus{width:58px;height:58px;background:#000;border-radius:50%;display:flex;justify-content:center;align-items:center;color:#fff;font-size:38px;font-weight:200;margin-top:-28px;border:4px solid #fff;box-shadow:0 4px 10px rgba(0,0,0,0.2);}
</style>
</head>
<body>

<div class="header">
  <div class="logo-left">
    <div class="b-icon">B</div>
    <div class="bharat-text">
      <span style="color:#FF9933; -webkit-text-stroke:0.7px #000;">BH</span><span style="color:#fff; -webkit-text-stroke:1.2px #000;">A</span><span style="color:#138808; -webkit-text-stroke:0.7px #000;">RAT</span>
      <div>FLIX</div>
    </div>
  </div>
  <div class="right">
    <div class="profile-top">B</div>
    <div style="font-size:22px;">⚙️</div>
  </div>
</div>

<div class="search"><input placeholder="Search Bharat Flix"></div>
<div class="chips"><span class="active">All</span><span>Bhakti</span><span>News</span><span>Movie</span><span>Music</span></div>

<div class="video">
  <video src="ad-new.mp4" autoplay muted loop controls playsinline></video>
</div>

<div class="details">
  <h3 style="font-size:17px;">Bharat Flix Welcome 🇮🇳</h3>
  <p style="color:#606060;font-size:13px;margin-top:4px;">12.4K views • 2 hours ago</p>
  <div class="actions"><span>👍 4.2K</span><span>👎 Dislike</span><span>↗️ Share</span><span>⬇️ Download</span><span>🔖 Save</span></div>
  <div style="display:flex;justify-content:space-between;align-items:center;">
    <div style="display:flex;gap:10px;align-items:center;"><div style="width:36px;height:36px;border-radius:50%;background:#6d28d9;color:white;display:flex;justify-content:center;align-items:center;font-weight:900;">B</div><div><b style="font-size:14px;">Bharat Flix Channel</b><p style="font-size:12px;color:#606060;">45.2K subscribers</p></div></div>
    <button class="subscribe">Subscribe</button>
  </div>
</div>

<div class="bottom">
  <div class="nav active">🏠<span>Home</span></div>
  <div class="nav">▶️<span>Shorts</span></div>
  <div class="nav"><div class="plus">+</div></div>
  <div class="nav">📺<span>Subscriptions</span></div>
  <div class="nav">📚<span>Library</span></div>
</div>

</body>
</html>
